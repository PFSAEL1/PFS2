{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "redirects": [
    {
      "source": "/about",
      "destination": "/company",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/service",
      "permanent": true
    },
    {
      "source": "/hydrogen-service-bays",
      "destination": "/products/custom-solutions/hydrogen-bus-finishing-system",
      "permanent": true
    },
    {
      "source": "/custom-hydrogen-service-bays-for-safe-vehicle-servicing",
      "destination": "/products/custom-solutions/hydrogen-bus-finishing-system",
      "permanent": true
    },
    {
      "source": "/service/california-waste",
      "destination": "/service/spray-to-waste",
      "permanent": true
    },
    {
      "source": "/parts/filters/andreae",
      "destination": "/parts/filters/paint-booth-filters",
      "permanent": true
    },
    {
      "source": "/large-equipment-booths/truck-semi-down-draft",
      "destination": "/products/paint-booths/truck-buses-fleet",
      "permanent": true
    },
    {
      "source": "/large-equipment-booths/truck-semi-down-draft/",
      "destination": "/products/paint-booths/truck-buses-fleet",
      "permanent": true
    },
    {
      "source": "/commercial-aerospace-aviation",
      "destination": "/industries/aerospace-defense",
      "permanent": true
    },
    {
      "source": "/commercial-aerospace-aviation/",
      "destination": "/industries/aerospace-defense",
      "permanent": true
    },
    {
      "source": "/revolutionizing-military-aviation-the-impact-of-paint-booths",
      "destination": "/industries/government-military",
      "permanent": true
    },
    {
      "source": "/aerospace-paint-booth-neshap-compliance-guide",
      "destination": "/parts/filters/neshap-aerospace-compliance",
      "permanent": true
    },
    {
      "source": "/paint-booth-maintenance-checklist-preventative-care",
      "destination": "/blog/spray-booth-maintenance-filter-checklist",
      "permanent": true
    },
    {
      "source": "/crossflow-vs-downdraft-paint-booths-comparison",
      "destination": "/blog/crossflow-vs-downdraft-spray-booth",
      "permanent": true
    },
    {
      "source": "/ul508a-certified-control-panels-industrial-finishing",
      "destination": "/blog/ul508a-certified-control-panel-spray-booth",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
